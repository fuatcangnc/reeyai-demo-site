---
import "../styles/global.css";
import ReeyaiBridge from "../components/ReeyaiBridge.astro";

interface Props {
	title?: string;
	description?: string;
}

const { title = "Demo", description = "Demo sitesi" } = Astro.props;
---

<!doctype html>
<html lang="tr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased">
		<header class="border-b border-zinc-800">
			<nav class="mx-auto flex max-w-2xl items-center justify-between px-4 py-4">
				<a href="/" class="font-semibold">Demo</a>
				<span class="text-xs text-zinc-500">İçerik GitHub'da yaşar</span>
			</nav>
		</header>
		<main class="mx-auto max-w-2xl px-4 py-10">
			<slot />
		</main>
		<footer class="mx-auto max-w-2xl px-4 py-10 text-xs text-zinc-500">
			Demo şablonu — build GitHub Actions'ta koşar.
		</footer>
		<ReeyaiBridge />
	</body>
</html>
