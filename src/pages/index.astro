---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base title="ReeyAI Demo">
	<h1 class="text-3xl font-bold tracking-tight">ReeyAI Demo</h1>
	<p class="mt-2 text-zinc-400">İçeriği GitHub reposunda yaşayan Astro sitesi.</p>

	<ul class="mt-10 space-y-8">
		{
			posts.map((post) => (
				<li>
					<a
						href={`/blog/${post.id}`}
						class="text-xl font-semibold hover:underline"
					>
						{post.data.title}
					</a>
					<p class="mt-1 text-sm text-zinc-500">
						{post.data.pubDate.toISOString().slice(0, 10)}
						{post.data.tags.length > 0 && <> · {post.data.tags.join(", ")}</>}
					</p>
					<p class="mt-1 text-zinc-300">{post.data.description}</p>
				</li>
			))
		}
	</ul>
</Base>
